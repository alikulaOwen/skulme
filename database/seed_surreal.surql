CREATE concept:searching_exponential_search SET slug = 'searching_exponential_search', title = 'Exponential Search', category = 'searching', description = '# Exponential Search\n\n**Category:** `searching` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nbinary search\n\n### Original Rust Signatures\n```rust\npub fn exponential_search(item: &T, arr: &[T]) -> Option<usize>;\n```\n\n### Complexity\n- **Time Complexity:** `O(N)`\n- **Space Complexity:** `O(1)`\n\n---\n\n## Java Interview Strategy & Tips\n\n- In Binary Search, ALWAYS calculate midpoint using `int mid = left + (right - left) / 2;` to avoid 32-bit integer', status = 'published';
CREATE implementation:searching_exponential_search_rust SET language = 'rust', source_code = 'use std::cmp::Ordering;\n\npub fn exponential_search<T: Ord>(item: &T, arr: &[T]) -> Option<usize> {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (exponential_search)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement exponential_search");\n}\n\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn empty() {\n        let index = exponential_search(&"a", &[]);\n        assert_eq!(index, None);\n    }\n\n    #[test]\n    fn one_item() {\n        let index = exponential_search(&"a", &["a"]);\n        assert_eq!(index, Some(0));\n    }\n\n    #[test]\n    fn search_strings() {\n        let index = exponential_search(&"a", &["a", "b", "c", "d", "google", "zoo"]);\n        assert_eq!(index, Some(0));\n    }\n\n    #[test]\n    fn search_ints() {\n        let index = exponential_search(&4, &[1, 2, 3, 4]);\n        assert_eq!(index, Some(3));\n\n        let index = exponential_search(&3, &[1, 2, 3, 4]);\n        assert_eq!(index, Some(2));\n\n        let index = exponential_search(&2, &[1, 2, 3, 4]);\n        assert_eq!(index, Some(1));\n\n        let index = exponential_search(&1, &[1, 2, 3, 4]);\n        assert_eq!(index, Some(0));\n    }\n\n    #[test]\n    fn not_found() {\n        let index = exponential_search(&5, &[1, 2, 3, 4]);\n        assert_eq!(index, None);\n    }\n}\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['searching', 'exponential_search'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/searching/exponential_search';
