CREATE concept:sorting_sort_utils SET slug = 'sorting_sort_utils', title = 'Sort Utils', category = 'sorting', description = '# Sort Utils\n\n**Category:** `sorting` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nImplement the Sort Utils algorithm in the sorting domain. The goal is to provide an efficient, robust solution that passes the test suite.\n\n### Original Rust Signatures\n```rust\npub fn generate_random_vec(n: u32, range_l: i32, range_r: i32) -> Vec<i32>;\npub fn generate_nearly_ordered_vec(n: u32, swap_times: u32) -> Vec<i32>;\npub fn generate_ordered_vec(n: u32) -', status = 'published';
CREATE implementation:sorting_sort_utils_rust SET language = 'rust', source_code = '\n#[cfg(test)]\nuse rand::RngExt;\n#[cfg(test)]\nuse std::time::Instant;\n\n#[cfg(test)]\npub fn generate_random_vec(n: u32, range_l: i32, range_r: i32) -> Vec<i32> {\n    let mut arr = Vec::<i32>::with_capacity(n as usize);\n    let mut rng = rand::rng();\n    let mut count = n;\n\n    while count > 0 {\n        arr.push(rng.random_range(range_l..=range_r));\n        count -= 1;\n    }\n\n    arr\n}\n\n#[cfg(test)]\npub fn generate_nearly_ordered_vec(n: u32, swap_times: u32) -> Vec<i32> {\n    let mut arr: Vec<i32> = (0..n as i32).collect();\n    let mut rng = rand::rng();\n\n    let mut count = swap_times;\n\n    while count > 0 {\n        arr.swap(\n            rng.random_range(0..n as usize),\n            rng.random_range(0..n as usize),\n        );\n        count -= 1;\n    }\n\n    arr\n}\n\n#[cfg(test)]\npub fn generate_ordered_vec(n: u32) -> Vec<i32> {\n    generate_nearly_ordered_vec(n, 0)\n}\n\n#[cfg(test)]\npub fn generate_reverse_ordered_vec(n: u32) -> Vec<i32> {\n    let mut arr = generate_ordered_vec(n);\n    arr.reverse();\n    arr\n}\n\n#[cfg(test)]\npub fn generate_repeated_elements_vec(n: u32, unique_elements: u8) -> Vec<i32> {\n    let mut rng = rand::rng();\n    let v = rng.random_range(0..n as i32);\n    generate_random_vec(n, v, v + unique_elements as i32)\n}\n\n#[cfg(test)]\npub fn log_timed<F>(test_name: &str, f: F)\nwhere\n    F: FnOnce(),\n{\n    let before = Instant::now();\n    f();\n    println!("Elapsed time of {:?} is {:?}", test_name, before.elapsed());\n}\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'sort_utils'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/sorting/sort_utils';
RELATE implementation:sorting_sort_utils_rust->IMPLEMENTS->concept:sorting_sort_utils;
