\n    // Follow the Socratic hints and questions in the comments above.\n    // ==========================================================', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['backtracking', 'parentheses_generator'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/backtracking/parentheses_generator';
