 /// The adjacency matrix representing the graph.\n    adjacency_matrix: Vec<Vec<bool>>,\n}\n\nimpl Graph {\n    /// Creates a new graph w', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['backtracking', 'hamiltonian_cycle'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/backtracking/hamiltonian_cycle';
