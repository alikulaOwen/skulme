ons in the comments above.\n    // =========================================================================\n    todo!("Implement kruskal");\n}\n\n\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'minimum_spanning_tree'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/graph/minimum_spanning_tree';
