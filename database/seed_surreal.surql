ssert_eq!(fast_factorial(19), factorial_bigmath(19));\n        assert_eq!(fast_factorial(30), factorial_bigmath(30));\n        assert_eq!', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['big_integer', 'fast_factorial'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/big_integer/fast_factorial';
