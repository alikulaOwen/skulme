CREATE concept:sorting_quick_sort SET slug = 'sorting_quick_sort', title = 'Quick Sort', category = 'sorting', description = '# Quick Sort\n\n**Category:** `sorting` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nImplement the Quick Sort algorithm in the sorting domain. The goal is to provide an efficient, robust solution that passes the test suite.\n\n### Original Rust Signatures\n```rust\npub fn partition(arr: &mut [T], lo: usize, hi: usize) -> usize;\npub fn quick_sort(arr: &mut [T]);\n```\n\n### Complexity\n- **Time Complexity:** `O(N)`\n- **Space Complexity:** `O(1)`\n\n---\n\n#', status = 'published';
CREATE implementation:sorting_quick_sort_rust SET language = 'rust', source_code = 'pub fn partition<T: PartialOrd>(arr: &mut [T], lo: usize, hi: usize) -> usize {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (partition)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement partition");\n}\n\nfn _quick_sort<T: Ord>(arr: &mut [T], mut lo: usize, mut hi: usize) {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (_quick_sort)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement _quick_sort");\n}\n\npub fn quick_sort<T: Ord>(arr: &mut [T]) {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (quick_sort)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement quick_sort");\n}\n\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::sorting::have_same_elements;\n    use crate::sorting::is_sorted;\n    use crate::sorting::sort_utils;\n\n    #[test]\n    fn basic() {\n        let mut res = vec![10, 8, 4, 3, 1, 9, 2, 7, 5, 6];\n        let cloned = res.clone();\n        quick_sort(&mut res);\n        assert!(is_sorted(&res) && have_same_elements(&res, &cloned));\n    }\n\n    #[test]\n    fn basic_string() {\n        let mut res = vec!["a", "bb", "d", "cc"];\n        let cloned = res.clone();\n        quick_sort(&mut res);\n        assert!(is_sorted(&res) && have_same_elements(&res, &cloned));\n    }\n\n    #[test]\n    fn empty() {\n        let mut res = Vec::<u8>::new();\n        let cloned = res.clone();\n        quick_sort(&mut res);\n        assert!(is_sorted(&res) && have_same_elements(&res, &cloned))', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'quick_sort'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/sorting/quick_sort';
RELATE implementation:sorting_quick_sort_rust->IMPLEMENTS->concept:sorting_quick_sort;
CREATE implementation:sorting_quick_sort_python SET language = 'python', source_code = 'def quick_sort(arr: list[int]) -> list[int]:\n    if len(arr) <= 1:\n        return arr\n    pivot = arr[len(arr) // 2]\n    left = [x for x in arr if x < pivot]\n    middle = [x for x in arr if x == pivot]\n    right = [x for x in arr if x > pivot]\n    return quick_sort(left) + middle + quick_sort(right)\n\nif __name__ == "__main__":\n    assert quick_sort([10, 7, 8, 9, 1, 5]) == [1, 5, 7, 8, 9, 10]\n    print("[PASS] Python Quick Sort passed!")\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'quick_sort'], license_spdx = 'MIT', origin_repo = 'repo:python', origin_path = 'problems/sorting/quick_sort';
RELATE implementation:sorting_quick_sort_python->IMPLEMENTS->concept:sorting_quick_sort;
CREATE implementation:sorting_quick_sort_java SET language = 'java', source_code = 'import java.util.*;\n\npublic class Solution {\n\n    /**\n     * Quick Sort: In-place, Divide-and-Conquer\n     * Time Complexity: O(N log N) average, O(N^2) worst\n     * Space Complexity: O(log N) stack\n     */\n    public static void quickSort(int[] arr) {\n        if (arr == null || arr.length <= 1) return;\n        quickSort(arr, 0, arr.length - 1);\n    }\n\n    private static void quickSort(int[] arr, int low, int high) {\n        if (low < high) {\n            int p = partition(arr, low, high);\n            quickSort(arr, low, p - 1);\n            quickSort(arr, p + 1, high);\n        }\n    }\n\n    private static int partition(int[] arr, int low, int high) {\n        int pivot = arr[high];\n        int i = low - 1;\n        for (int j = low; j < high; j++) {\n            if (arr[j] <= pivot) {\n                i++;\n                swap(arr, i, j);\n            }\n        }\n        swap(arr, i + 1, high);\n        return i + 1;\n    }\n\n    private static void swap(int[] arr, int i, int j) {\n        int t = arr[i];\n        arr[i] = arr[j];\n        arr[j] = t;\n    }\n\n    public static void main(String[] args) {\n        System.out.println("Running Quick Sort Tests...");\n        int[] arr = {10, 7, 8, 9, 1, 5};\n        quickSort(arr);\n        assert Arrays.equals(arr, new int[]{1, 5, 7, 8, 9, 10}) : "Failed quick sort";\n        System.out.println("[PASS] All Quick Sort test cases passed!");\n    }\n}', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'quick_sort'], license_spdx = 'MIT', origin_repo = 'repo:java', origin_path = 'problems/sorting/quick_sort';
RELATE implementation:sorting_quick_sort_java->IMPLEMENTS->concept:sorting_quick_sort;
CREATE implementation:sorting_quick_sort_typescript SET language = 'typescript', source_code = 'function quickSort(arr: number[]): number[] {\n    if (arr.length <= 1) return arr;\n    const pivot = arr[Math.floor(arr.length / 2)];\n    const left = arr.filter(x => x < pivot);\n    const mid = arr.filter(x => x === pivot);\n    const right = arr.filter(x => x > pivot);\n    return quickSort(left).concat(mid).concat(quickSort(right));\n}\n\nif (JSON.stringify(quickSort([10, 7, 8, 9, 1, 5])) !== JSON.stringify([1, 5, 7, 8, 9, 10])) throw new Error("Failed");\nconsole.log("[PASS] TypeScript Quick Sort passed!");\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'quick_sort'], license_spdx = 'MIT', origin_repo = 'repo:typescript', origin_path = 'problems/sorting/quick_sort';
RELATE implementation:sorting_quick_sort_typescript->IMPLEMENTS->concept:sorting_quick_sort;
