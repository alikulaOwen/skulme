/\n    #[test]\n    fn test_kadanes_algorithm_empty() {\n        let arr: [i32; 0] = [];\n        assert_eq!(max_sub_array(arr.to_vec()), 0);\n    }\n\n    /**\n     *', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['general', 'kadane_algorithm'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/general/kadane_algorithm';
