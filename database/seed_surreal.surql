partition_100() {\n        assert_eq!(partition(100), 190569292);\n    }\n\n    #[test]\n    #[allow(clippy::large_stack_arrays)]\n    fn test_partition_1000() {\n        a', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['dynamic_programming', 'integer_partition'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/dynamic_programming/integer_partition';
