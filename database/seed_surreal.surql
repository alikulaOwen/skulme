            (\'t\', 1),\n                (\'-\', 1),\n                (\'T\', 1),\n                (\'r\', 1),\n                (\'e\', 1),\n                (\'n\', 1),\n                (\'d\', 1),\n   ', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['compression', 'run_length_encoding'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/compression/run_length_encoding';
