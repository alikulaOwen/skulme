CREATE implementation:dynamic_programming_snail_rust SET language = 'rust', source_code = '/// ## Spiral Sorting\n///\n/// Given an n x m array, return the array elements arranged from outermost elements\n/// to the middle element, traveling INWARD FROM TOP-LEFT, CLOCKWISE.\npub fn snail<T: Copy>(matrix: &[Vec<T>]) -> Vec<T> {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (snail)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement snail");\n}\n\nenum Direction {\n    Right,\n    Left,\n    Down,\n    Up,\n}\n\nimpl Direction {\n    pub fn snail_move(\n        &mut self,\n        col: &mut usize,\n        row: &mut usize,\n        min_col: &mut usize,\n        max_col: &mut usize,\n        min_row: &mut usize,\n        max_row: &mut usize,\n    ) {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (snail_move)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement snail_move");\n}\n}\n\n\n#[cfg(test)]\nmod test {\n    use super::*;\n\n    #[test]\n    fn test_empty() {\n        let empty: &[Vec<i32>] = &[vec![]];\n        assert_eq!(snail(empty), vec![]);\n    }\n\n    #[test]\n    fn test_int() {\n        let square = &[vec![1, 2, 3], vec![4, 5, 6], vec![7, 8, 9]];\n        assert_eq!(snail(square), vec![1, 2, 3, 6, 9, 8, 7, 4, 5]);\n    }\n\n    #[test]\n    fn test_char() {\n        let square = &[\n            vec![\'S\', \'O\', \'M\'],\n            vec![\'E\', \'T\', \'H\'],\n            vec![\'I\', \'N\', \'G\'],\n        ];\n        assert_eq!(\n            snail(square),\n            vec![\'S\', \'O\', \'M\', \'H\', \'G\', \'N\', \'I\', \'E\', \'T\']\n        );\n    }\n\n    #[test]\n    fn test_rect() {\n        let square = &[\n            vec![\'H\', \'E\', \'L\', \'L\'],\n            vec![\'O\', \' \', \'W\', \'O\'],\n            vec![\'R\', \'L\', \'D\', \' \'],\n        ];\n ', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['dynamic_programming', 'snail'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/dynamic_programming/snail';
