ee() {\n        let points = vec![\n            (2.312, 8.345344),\n            (-2.312, 8.345344),\n            (-0.7051, 3.49716601),\n            (0.7051, 3.49716', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['math', 'least_square_approx'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/math/least_square_approx';
