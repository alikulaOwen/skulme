CREATE concept:string_hamming_distance SET slug = 'string_hamming_distance', title = 'Hamming Distance', category = 'string', description = '# Hamming Distance\n\n**Category:** `string` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\n/ Error type for Hamming distance calculation.\n\n### Original Rust Signatures\n```rust\npub fn hamming_distance(string_a: &str, string_b: &str) -> Result<usize, HammingDistanceError>;\n```\n\n### Complexity\n- **Time Complexity:** `O(N)`\n- **Space Complexity:** `O(1)`\n\n---\n\n## Java Interview Strategy & Tips\n\n- Strings in Java are immutable! `str += "a"` creates a', status = 'published';
CREATE implementation:string_hamming_distance_rust SET language = 'rust', source_code = '/// Error type for Hamming distance calculation.\n#[derive(Debug, PartialEq)]\npub enum HammingDistanceError {\n    InputStringsHaveDifferentLength,\n}\n\n/// Calculates the Hamming distance between two strings.\n///\n/// The Hamming distance is defined as the number of positions at which the corresponding characters of the two strings are different.\npub fn hamming_distance(string_a: &str, string_b: &str) -> Result<usize, HammingDistanceError> {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (hamming_distance)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement hamming_distance");\n}\n\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    macro_rules! test_hamming_distance {\n        ($($name:ident: $tc:expr,)*) => {\n            $(\n                #[test]\n                fn $name() {\n                    let (str_a, str_b, expected) = $tc;\n                    assert_eq!(hamming_distance(str_a, str_b), expected);\n                    assert_eq!(hamming_distance(str_b, str_a), expected);\n                }\n            )*\n        }\n    }\n\n    test_hamming_distance! {\n        empty_inputs: ("", "", Ok(0)),\n        different_length: ("0", "", Err(HammingDistanceError::InputStringsHaveDifferentLength)),\n        length_1_inputs_identical: ("a", "a", Ok(0)),\n        length_1_inputs_different: ("a", "b", Ok(1)),\n        same_strings: ("rust", "rust", Ok(0)),\n        regular_input_0: ("karolin", "kathrin", Ok(3)),\n        regular_input_1: ("kathrin", "kerstin", Ok(4)),\n        regular_input_2: ("00000", "11111", Ok(5)),\n        different_case: ("x", "X", Ok(1)),\n        strings_with_no_common_chars: ("abcd", "wxyz", Ok(4)),\n        long_strings_one_diff: (&"a".repeat(1000), &("a".repeat(999) + "b"), Ok(1)),\n        long_strings_many_diffs: (&("a".repeat(500) + &"b".repeat(500)), &("b".repeat(500) +', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['string', 'hamming_distance'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/string/hamming_distance';
RELATE implementation:string_hamming_distance_rust->IMPLEMENTS->concept:string_hamming_distance;
