, 0.0, 1).unwrap();\n        assert!((result - 1000.0).abs() < EPSILON);\n\n        // Error cases\n        assert_eq!(\n            equated_monthly_installmen', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['financial', 'equated_monthly_installments'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/financial/equated_monthly_installments';
