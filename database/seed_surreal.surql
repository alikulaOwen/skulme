                if let Some(head) = linked_list.head {\n                    tail.as_mut().next = Some(head);\n                }\n            }\n        ', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['data_structures', 'floyds_algorithm'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/data_structures/floyds_algorithm';
