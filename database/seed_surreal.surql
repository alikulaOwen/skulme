f {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (fr', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['data_structures', 'heap'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/data_structures/heap';
