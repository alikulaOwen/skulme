CREATE concept:graph_breadth_first_search SET slug = 'graph_breadth_first_search', title = 'Breadth First Search', category = 'graph', description = '# Breadth First Search\n\n**Category:** `graph` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nPerform a breadth-first search on Graph `graph`.\n\n# Parameters\n\n- `graph`: The graph to search.\n- `root`: The starting node of the graph from which to begin searching.\n- `target`: The target node for the search.\n\n# Returns\n\nIf the target is found, an Optional vector is returned with the history\nof nodes visited as its contents.\n\nIf the target is not fou', status = 'published';
CREATE implementation:graph_breadth_first_search_rust SET language = 'rust', source_code = 'use std::collections::HashSet;\nuse std::collections::VecDeque;\n\n/// Perform a breadth-first search on Graph `graph`.\n///\n/// # Parameters\n///\n/// - `graph`: The graph to search.\n/// - `root`: The starting node of the graph from which to begin searching.\n/// - `target`: The target node for the search.\n///\n/// # Returns\n///\n/// If the target is found, an Optional vector is returned with the history\n/// of nodes visited as its contents.\n///\n/// If the target is not found or there is no path from the root,\n/// `None` is returned.\n///\npub fn breadth_first_search(graph: &Graph, root: Node, target: Node) -> Option<Vec<u32>> {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (breadth_first_search)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement breadth_first_search");\n}\n\n// Data Structures\n\n#[derive(Copy, Clone, PartialEq, Eq, Hash)]\npub struct Node(u32);\n\n#[derive(Copy, Clone, PartialEq, Eq, Hash)]\npub struct Edge(u32, u32);\n\n#[derive(Clone)]\npub struct Graph {\n    #[allow(dead_code)]\n    nodes: Vec<Node>,\n    edges: Vec<Edge>,\n}\n\nimpl Graph {\n    pub fn new(nodes: Vec<Node>, edges: Vec<Edge>) -> Self {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (new)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement new");\n}\n}\n\nimpl From<u32> for Node {\n    fn from(item: u32) -> Self {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (from)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement fr', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'breadth_first_search'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/graph/breadth_first_search';
RELATE implementation:graph_breadth_first_search_rust->IMPLEMENTS->concept:graph_breadth_first_search;
CREATE implementation:graph_breadth_first_search_python SET language = 'python', source_code = 'from collections import deque\n\ndef bfs(graph: dict[int, list[int]], start: int) -> list[int]:\n    visited = set([start])\n    queue = deque([start])\n    order = []\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n        for neighbor in graph.get(node, []):\n            if neighbor not in visited:\n                visited.add(neighbor)\n                queue.append(neighbor)\n    return order\n\nif __name__ == "__main__":\n    g = {0: [1, 2], 1: [2], 2: [0, 3], 3: [3]}\n    assert bfs(g, 2) == [2, 0, 3, 1]\n    print("[PASS] Python BFS passed!")\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'breadth_first_search'], license_spdx = 'MIT', origin_repo = 'repo:python', origin_path = 'problems/graph/breadth_first_search';
RELATE implementation:graph_breadth_first_search_python->IMPLEMENTS->concept:graph_breadth_first_search;
CREATE implementation:graph_breadth_first_search_java SET language = 'java', source_code = 'import java.util.*;\n\npublic class Solution {\n\n    /**\n     * Breadth-First Search (BFS): Level-order graph traversal\n     * Time Complexity: O(V + E)\n     * Space Complexity: O(V)\n     */\n    public static List<Integer> bfs(Map<Integer, List<Integer>> graph, int start) {\n        List<Integer> visitedOrder = new ArrayList<>();\n        Set<Integer> visited = new HashSet<>();\n        // Use ArrayDeque for BFS queue (faster than LinkedList)\n        Queue<Integer> queue = new ArrayDeque<>();\n\n        queue.offer(start);\n        visited.add(start);\n\n        while (!queue.isEmpty()) {\n            int node = queue.poll();\n            visitedOrder.add(node);\n\n            List<Integer> neighbors = graph.getOrDefault(node, Collections.emptyList());\n            for (int neighbor : neighbors) {\n                if (!visited.contains(neighbor)) {\n                    visited.add(neighbor);\n                    queue.offer(neighbor);\n                }\n            }\n        }\n        return visitedOrder;\n    }\n\n    public static void main(String[] args) {\n        System.out.println("Running BFS Tests...");\n        Map<Integer, List<Integer>> graph = new HashMap<>();\n        graph.put(0, Arrays.asList(1, 2));\n        graph.put(1, Arrays.asList(2));\n        graph.put(2, Arrays.asList(0, 3));\n        graph.put(3, Arrays.asList(3));\n\n        List<Integer> order = bfs(graph, 2);\n        assert order.equals(Arrays.asList(2, 0, 3, 1)) : "Failed BFS order";\n        System.out.println("[PASS] All BFS test cases passed!");\n    }\n}', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'breadth_first_search'], license_spdx = 'MIT', origin_repo = 'repo:java', origin_path = 'problems/graph/breadth_first_search';
RELATE implementation:graph_breadth_first_search_java->IMPLEMENTS->concept:graph_breadth_first_search;
CREATE implementation:graph_breadth_first_search_typescript SET language = 'typescript', source_code = 'function bfs(graph: Record<number, number[]>, start: number): number[] {\n    const visited = new Set<number>([start]);\n    const queue = [start];\n    const order: number[] = [];\n    while (queue.length > 0) {\n        const node = queue.shift()!;\n        order.push(node);\n        for (const neighbor of graph[node] || []) {\n            if (!visited.has(neighbor)) {\n                visited.add(neighbor);\n                queue.push(neighbor);\n            }\n        }\n    }\n    return order;\n}\n\nconst g = {0: [1, 2], 1: [2], 2: [0, 3], 3: [3]};\nif (JSON.stringify(bfs(g, 2)) !== JSON.stringify([2, 0, 3, 1])) throw new Error("Failed");\nconsole.log("[PASS] TypeScript BFS passed!");\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'breadth_first_search'], license_spdx = 'MIT', origin_repo = 'repo:typescript', origin_path = 'problems/graph/breadth_first_search';
RELATE implementation:graph_breadth_first_search_typescript->IMPLEMENTS->concept:graph_breadth_first_search;
