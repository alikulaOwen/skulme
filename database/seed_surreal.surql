s negative or not a valid number\n/// * `unit_from` or `unit_to` is not a valid time unit\npub fn convert_time(time_value: f64, unit_from: &', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['conversions', 'time'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/conversions/time';
