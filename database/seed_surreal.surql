CREATE concept:searching_binary_search SET slug = 'searching_binary_search', title = 'Binary Search', category = 'searching', description = '# Binary Search\n\n**Category:** `searching` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nThis module provides an implementation of a binary search algorithm that\nworks for both ascending and descending ordered arrays. The binary search\nfunction returns the index of the target element if it is found, or `None`\nif the target is not present in the array.\n\n### Original Rust Signatures\n```rust\npub fn binary_search(item: &T, arr: &[T]) -> Option<usi', status = 'published';
CREATE implementation:searching_binary_search_rust SET language = 'rust', source_code = '//! =============================================================================\n//! The High-Frequency Stock Lookup: Binary Search\n//! CATEGORY: searching\n//! =============================================================================\n//!\n//! -----------------------------------------------------------------------------\n//! 1. REAL-WORLD STORY & CONTEXT (WHAT IS THIS?)\n//! -----------------------------------------------------------------------------\n//! Imagine querying a sorted book of stock transactions:\n//! - In an array of N sorted prices, find the exact index of target price.\n//! - Cutting search space in half at each step gives O(log N) speed.\n//!\n//! -----------------------------------------------------------------------------\n//! 2. GUIDED HINTING QUESTIONS AS YOUR PROBLEM SPECIFICATION\n//! -----------------------------------------------------------------------------\n//! ❓ Q1: How to avoid integer overflow? (int mid = left + (right - left) / 2)\n//! ❓ Q2: When to move left? When to move right?\n//! ❓ Q3: When is target found?\n//! -----------------------------------------------------------------------------\n\n//! This module provides an implementation of a binary search algorithm that\n//! works for both ascending and descending ordered arrays. The binary search\n//! function returns the index of the target element if it is found, or `None`\n//! if the target is not present in the array.\n\nuse std::cmp::Ordering;\n\n/// Performs a binary search for a specified item within a sorted array.\n///\n/// This function can handle both ascending and descending ordered arrays. It\n/// takes a reference to the item to search for and a slice of the array. If\n/// the item is found, it returns the index of the item within the array. If\n/// the item is not found, it returns `None`.\n///\n/// # Parameters\n///\n/// - `item`: A reference to the item to search for.\n/// - `arr`: A slice of the sorted array in which to search.\n///\n/// # Returns\n///\n/// An `Option<usize>` which is:\n/// - `Som', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['searching', 'binary_search'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/searching/binary_search';
RELATE implementation:searching_binary_search_rust->IMPLEMENTS->concept:searching_binary_search;
CREATE implementation:searching_binary_search_python SET language = 'python', source_code = 'def binary_search(nums: list[int], target: int) -> int:\n    left, right = 0, len(nums) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        elif nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n\nif __name__ == "__main__":\n    nums = [1, 3, 5, 7, 9, 11, 15, 20]\n    assert binary_search(nums, 1) == 0\n    assert binary_search(nums, 7) == 3\n    assert binary_search(nums, 20) == 7\n    assert binary_search(nums, 2) == -1\n    print("[PASS] Python Binary Search passed!")\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['searching', 'binary_search'], license_spdx = 'MIT', origin_repo = 'repo:python', origin_path = 'problems/searching/binary_search';
RELATE implementation:searching_binary_search_python->IMPLEMENTS->concept:searching_binary_search;
CREATE implementation:searching_binary_search_java SET language = 'java', source_code = 'import java.util.*;\n\npublic class Solution {\n\n    /**\n     * Binary Search: returns index of target in sorted array, or -1 if not found.\n     * Time Complexity: O(log N)\n     * Space Complexity: O(1)\n     */\n    public static int binarySearch(int[] nums, int target) {\n        if (nums == null || nums.length == 0) return -1;\n        int left = 0, right = nums.length - 1;\n\n        while (left <= right) {\n            // Avoid integer overflow vs (left + right) / 2\n            int mid = left + (right - left) / 2;\n\n            if (nums[mid] == target) {\n                return mid;\n            } else if (nums[mid] < target) {\n                left = mid + 1;\n            } else {\n                right = mid - 1;\n            }\n        }\n        return -1;\n    }\n\n    public static void main(String[] args) {\n        System.out.println("Running Binary Search Tests...");\n        int[] sorted = {1, 3, 5, 7, 9, 11, 15, 20};\n        assert binarySearch(sorted, 1) == 0 : "Failed: search 1";\n        assert binarySearch(sorted, 7) == 3 : "Failed: search 7";\n        assert binarySearch(sorted, 20) == 7 : "Failed: search 20";\n        assert binarySearch(sorted, 2) == -1 : "Failed: search 2 (missing)";\n        assert binarySearch(new int[]{}, 5) == -1 : "Failed: empty array";\n        assert binarySearch(new int[]{42}, 42) == 0 : "Failed: single element found";\n        assert binarySearch(new int[]{42}, 10) == -1 : "Failed: single element missing";\n        System.out.println("[PASS] All Binary Search test cases passed!");\n    }\n}', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['searching', 'binary_search'], license_spdx = 'MIT', origin_repo = 'repo:java', origin_path = 'problems/searching/binary_search';
RELATE implementation:searching_binary_search_java->IMPLEMENTS->concept:searching_binary_search;
CREATE implementation:searching_binary_search_typescript SET language = 'typescript', source_code = 'function binarySearch(nums: number[], target: number): number {\n    let left = 0, right = nums.length - 1;\n    while (left <= right) {\n        const mid = left + Math.floor((right - left) / 2);\n        if (nums[mid] === target) return mid;\n        if (nums[mid] < target) left = mid + 1;\n        else right = mid - 1;\n    }\n    return -1;\n}\n\nconst nums = [1, 3, 5, 7, 9, 11, 15, 20];\nif (binarySearch(nums, 1) !== 0) throw new Error("Test 1 failed");\nif (binarySearch(nums, 7) !== 3) throw new Error("Test 2 failed");\nif (binarySearch(nums, 2) !== -1) throw new Error("Test 3 failed");\nconsole.log("[PASS] TypeScript Binary Search passed!");\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['searching', 'binary_search'], license_spdx = 'MIT', origin_repo = 'repo:typescript', origin_path = 'problems/searching/binary_search';
RELATE implementation:searching_binary_search_typescript->IMPLEMENTS->concept:searching_binary_search;
