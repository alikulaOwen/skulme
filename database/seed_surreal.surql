CREATE concept:sorting_cycle_sort SET slug = 'sorting_cycle_sort', title = 'Cycle Sort', category = 'sorting', description = '# Cycle Sort\n\n**Category:** `sorting` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nsorts with the minimum number of rewrites. Runs through all values in the array, placing them in their correct spots. O(n^2).\n\n### Original Rust Signatures\n```rust\npub fn cycle_sort(arr: &mut [i32]);\n```\n\n### Complexity\n- **Time Complexity:** `O(N)`\n- **Space Complexity:** `O(1)`\n\n---\n\n## Java Interview Strategy & Tips\n\n- Java\'s `Arrays.sort(primitive[])` uses ', status = 'published';
CREATE implementation:sorting_cycle_sort_rust SET language = 'rust', source_code = '// sorts with the minimum number of rewrites. Runs through all values in the array, placing them in their correct spots. O(n^2).\n\npub fn cycle_sort(arr: &mut [i32]) {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (cycle_sort)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement cycle_sort");\n}\n\n\n#[cfg(test)]\nmod tests {\n\n    use super::*;\n    use crate::sorting::have_same_elements;\n    use crate::sorting::is_sorted;\n\n    #[test]\n    fn it_works() {\n        let mut arr1 = [6, 5, 4, 3, 2, 1];\n        let cloned = arr1;\n        cycle_sort(&mut arr1);\n        assert!(is_sorted(&arr1) && have_same_elements(&arr1, &cloned));\n        arr1 = [12, 343, 21, 90, 3, 21];\n        let cloned = arr1;\n        cycle_sort(&mut arr1);\n        assert!(is_sorted(&arr1) && have_same_elements(&arr1, &cloned));\n        let mut arr2 = [1];\n        let cloned = arr2;\n        cycle_sort(&mut arr2);\n        assert!(is_sorted(&arr2) && have_same_elements(&arr2, &cloned));\n        let mut arr3 = [213, 542, 90, -23412, -32, 324, -34, 3324, 54];\n        let cloned = arr3;\n        cycle_sort(&mut arr3);\n        assert!(is_sorted(&arr3) && have_same_elements(&arr3, &cloned));\n    }\n}\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'cycle_sort'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/sorting/cycle_sort';
