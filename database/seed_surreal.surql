uffmanNode<T> {\n    /// Turn the tree into the map that can be used in encoding\n    pub fn get_alphabet(\n        height: u32,\n        path: u64,', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['general', 'huffman_encoding'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/general/huffman_encoding';
