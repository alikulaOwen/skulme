ent is out of range.\npub fn compound_interest(\n    principal: f64,\n    nominal_annual_interest_rate: f64,\n    number_of_compounding', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['financial', 'interest'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/financial/interest';
