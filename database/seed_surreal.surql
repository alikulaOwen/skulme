CREATE concept:math_simpsons_integration SET slug = 'math_simpsons_integration', title = 'Simpsons Integration', category = 'math', description = '# Simpsons Integration\n\n**Category:** `math` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nCalculate the length of the curve f(x) = x^2 for -5 <= x <= 5\nWe should integrate sqrt(1 + (f\'(x))^2)\n\n### Original Rust Signatures\n```rust\npub fn simpsons_integration(f: F, a: f64, b: f64, n: usize) -> f64\nwhere\n    F: Fn(f64) -> f64,;\n```\n\n### Complexity\n- **Time Complexity:** `O(N)`\n- **Space Complexity:** `O(1)`\n\n---\n\n## Java Interview Strategy & Tip', status = 'published';
CREATE implementation:math_simpsons_integration_rust SET language = 'rust', source_code = 'pub fn simpsons_integration<F>(f: F, a: f64, b: f64, n: usize) -> f64\nwhere\n    F: Fn(f64) -> f64,\n{\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (simpsons_integration)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement simpsons_integration");\n}\n\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_simpsons_integration() {\n        let f = |x: f64| x.powi(2);\n        let a = 0.0;\n        let b = 1.0;\n        let n = 100;\n        let result = simpsons_integration(f, a, b, n);\n        assert!((result - 1.0 / 3.0).abs() < 1e-6);\n    }\n\n    #[test]\n    fn test_error() {\n        let f = |x: f64| x.powi(2);\n        let a = 0.0;\n        let b = 1.0;\n        let n = 100;\n        let result = simpsons_integration(f, a, b, n);\n        let error = (1.0 / 3.0 - result).abs();\n        assert!(error < 1e-6);\n    }\n\n    #[test]\n    fn test_convergence() {\n        let f = |x: f64| x.powi(2);\n        let a = 0.0;\n        let b = 1.0;\n        let n = 100;\n        let result1 = simpsons_integration(f, a, b, n);\n        let result2 = simpsons_integration(f, a, b, 2 * n);\n        let result3 = simpsons_integration(f, a, b, 4 * n);\n        let result4 = simpsons_integration(f, a, b, 8 * n);\n        assert!((result1 - result2).abs() < 1e-6);\n        assert!((result2 - result3).abs() < 1e-6);\n        assert!((result3 - result4).abs() < 1e-6);\n    }\n\n    #[test]\n    fn test_negative() {\n        let f = |x: f64| -x.powi(2);\n        let a = 0.0;\n        let b = 1.0;\n        let n = 100;\n        let result = simpsons_integration(f, a, b, n);\n        assert!((result + 1.0 / 3.0).abs() < 1e-6);\n    }\n\n    #[test]\n    fn test_non_zero_lower_bound() {\n        let f = |x: f64| x.powi(2);\n        let a = 1.0;\n        let b = 2.0;\n        let n = 100;\n        let result = simpsons_integ', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['math', 'simpsons_integration'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/math/simpsons_integration';
