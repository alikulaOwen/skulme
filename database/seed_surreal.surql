CREATE concept:graph_dijkstra SET slug = 'graph_dijkstra', title = 'Dijkstra', category = 'graph', description = '# Dijkstra\n\n**Category:** `graph` | **Language Track:** Java (Interview Focus), Rust, Python, TypeScript\n\n---\n\n## Problem Statement\n\nperforms Dijsktra\'s algorithm on the given graph from the given start\nthe graph is a positively-weighted directed graph\n\nreturns a map that for each reachable vertex associates the distance and the predecessor\nsince the start has no predecessor but is reachable, map[start] will be None\n\nTime: O(E * logV). For each vertex, we traverse each edge, resulting in O(E). F', status = 'published';
CREATE implementation:graph_dijkstra_rust SET language = 'rust', source_code = 'use std::collections::{BTreeMap, BTreeSet};\nuse std::ops::Add;\n\ntype Graph<V, E> = BTreeMap<V, BTreeMap<V, E>>;\n\n// performs Dijsktra\'s algorithm on the given graph from the given start\n// the graph is a positively-weighted directed graph\n//\n// returns a map that for each reachable vertex associates the distance and the predecessor\n// since the start has no predecessor but is reachable, map[start] will be None\n//\n// Time: O(E * logV). For each vertex, we traverse each edge, resulting in O(E). For each edge, we\n// insert a new shortest path for a vertex into the tree, resulting in O(E * logV).\n// Space: O(V). The tree holds up to V vertices.\npub fn dijkstra<V: Ord + Copy, E: Ord + Copy + Add<Output = E>>(\n    graph: &Graph<V, E>,\n    start: V,\n) -> BTreeMap<V, Option<(V, E)>> {\n    // =========================================================================\n    // 🎯 YOUR MISSION: IMPLEMENT THIS METHOD (dijkstra)!\n    // Follow the Socratic hints and questions in the comments above.\n    // =========================================================================\n    todo!("Implement dijkstra");\n}\n\n\n#[cfg(test)]\nmod tests {\n    use super::{dijkstra, Graph};\n    use std::collections::BTreeMap;\n\n    fn add_edge<V: Ord + Copy, E: Ord>(graph: &mut Graph<V, E>, v1: V, v2: V, c: E) {\n        graph.entry(v1).or_default().insert(v2, c);\n        graph.entry(v2).or_default();\n    }\n\n    #[test]\n    fn single_vertex() {\n        let mut graph: Graph<usize, usize> = BTreeMap::new();\n        graph.insert(0, BTreeMap::new());\n\n        let mut dists = BTreeMap::new();\n        dists.insert(0, None);\n\n        assert_eq!(dijkstra(&graph, 0), dists);\n    }\n\n    #[test]\n    fn single_edge() {\n        let mut graph = BTreeMap::new();\n        add_edge(&mut graph, 0, 1, 2);\n\n        let mut dists_0 = BTreeMap::new();\n        dists_0.insert(0, None);\n        dists_0.insert(1, Some((0, 2)));\n\n        assert_eq!(dijkstra(&graph, 0), dists_0);\n\n        let mut dists_1 = BTreeMap::new();\n        d', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'dijkstra'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/graph/dijkstra';
RELATE implementation:graph_dijkstra_rust->IMPLEMENTS->concept:graph_dijkstra;
CREATE implementation:graph_dijkstra_python SET language = 'python', source_code = 'import heapq\n\ndef dijkstra(graph: dict[int, list[tuple[int, int]]], source: int) -> dict[int, int]:\n    dist = {source: 0}\n    pq = [(0, source)]\n    while pq:\n        d, u = heapq.heappop(pq)\n        if d > dist.get(u, float(\'inf\')):\n            continue\n        for v, weight in graph.get(u, []):\n            if d + weight < dist.get(v, float(\'inf\')):\n                dist[v] = d + weight\n                heapq.heappush(pq, (d + weight, v))\n    return dist\n\nif __name__ == "__main__":\n    g = {\n        0: [(1, 4), (2, 1)],\n        2: [(1, 2), (3, 5)],\n        1: [(3, 1)]\n    }\n    d = dijkstra(g, 0)\n    assert d[1] == 3\n    assert d[3] == 4\n    print("[PASS] Python Dijkstra passed!")\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'dijkstra'], license_spdx = 'MIT', origin_repo = 'repo:python', origin_path = 'problems/graph/dijkstra';
RELATE implementation:graph_dijkstra_python->IMPLEMENTS->concept:graph_dijkstra;
CREATE implementation:graph_dijkstra_java SET language = 'java', source_code = 'import java.util.*;\n\npublic class Solution {\n\n    public static class Edge {\n        int to, weight;\n        public Edge(int to, int weight) {\n            this.to = to;\n            this.weight = weight;\n        }\n    }\n\n    /**\n     * Dijkstra\'s Shortest Path Algorithm\n     * Time Complexity: O((V + E) log V)\n     * Space Complexity: O(V)\n     */\n    public static Map<Integer, Integer> dijkstra(Map<Integer, List<Edge>> graph, int source) {\n        Map<Integer, Integer> dist = new HashMap<>();\n        // PriorityQueue stores [node, distance], min-heap ordered by distance\n        PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[1]));\n\n        dist.put(source, 0);\n        pq.offer(new int[]{source, 0});\n\n        while (!pq.isEmpty()) {\n            int[] curr = pq.poll();\n            int u = curr[0];\n            int d = curr[1];\n\n            // If we found a shorter path already, skip\n            if (d > dist.getOrDefault(u, Integer.MAX_VALUE)) continue;\n\n            for (Edge edge : graph.getOrDefault(u, Collections.emptyList())) {\n                int nextDist = d + edge.weight;\n                if (nextDist < dist.getOrDefault(edge.to, Integer.MAX_VALUE)) {\n                    dist.put(edge.to, nextDist);\n                    pq.offer(new int[]{edge.to, nextDist});\n                }\n            }\n        }\n        return dist;\n    }\n\n    public static void main(String[] args) {\n        System.out.println("Running Dijkstra Tests...");\n        Map<Integer, List<Edge>> graph = new HashMap<>();\n        graph.computeIfAbsent(0, k -> new ArrayList<>()).add(new Edge(1, 4));\n        graph.computeIfAbsent(0, k -> new ArrayList<>()).add(new Edge(2, 1));\n        graph.computeIfAbsent(2, k -> new ArrayList<>()).add(new Edge(1, 2));\n        graph.computeIfAbsent(1, k -> new ArrayList<>()).add(new Edge(3, 1));\n        graph.computeIfAbsent(2, k -> new ArrayList<>()).add(new Edge(3, 5));\n\n        Map<Integer, Integer> dists = dijkstra(graph, 0);\n        ass', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'dijkstra'], license_spdx = 'MIT', origin_repo = 'repo:java', origin_path = 'problems/graph/dijkstra';
RELATE implementation:graph_dijkstra_java->IMPLEMENTS->concept:graph_dijkstra;
CREATE implementation:graph_dijkstra_typescript SET language = 'typescript', source_code = 'function dijkstra(graph: Record<number, Array<[number, number]>>, source: number): Record<number, number> {\n    const dist: Record<number, number> = { [source]: 0 };\n    const queue: Array<[number, number]> = [[0, source]];\n\n    while (queue.length > 0) {\n        queue.sort((a, b) => a[0] - b[0]);\n        const [d, u] = queue.shift()!;\n        if (d > (dist[u] ?? Infinity)) continue;\n        for (const [v, w] of graph[u] || []) {\n            if (d + w < (dist[v] ?? Infinity)) {\n                dist[v] = d + w;\n                queue.push([d + w, v]);\n            }\n        }\n    }\n    return dist;\n}\n\nconst g = {0: [[1, 4], [2, 1]], 2: [[1, 2], [3, 5]], 1: [[3, 1]]};\nconst res = dijkstra(g as any, 0);\nif (res[1] !== 3 || res[3] !== 4) throw new Error("Failed");\nconsole.log("[PASS] TypeScript Dijkstra passed!");\n', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['graph', 'dijkstra'], license_spdx = 'MIT', origin_repo = 'repo:typescript', origin_path = 'problems/graph/dijkstra';
RELATE implementation:graph_dijkstra_typescript->IMPLEMENTS->concept:graph_dijkstra;
