t mut ve2 = vec![1, 2, 3, 4, 5, 6];\n        let cloned = ve2.clone();\n        bubble_sort(&mut ve2);\n        assert!(is_sorted(&ve2) ', ast_hash = 'seed_hash', commit_sha = 'HEAD', original_authors = ['TheAlgorithms Community'], keywords = ['sorting', 'bubble_sort'], license_spdx = 'MIT', origin_repo = 'repo:rust', origin_path = 'problems/sorting/bubble_sort';
